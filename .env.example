NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase (server-only secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Customer API and outbound webhooks
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_MS=60000
# Base64-encoded 32-byte AES key. Generate securely and store server-side only.
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000

# Vapi (API key is reserved for future provisioning)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
